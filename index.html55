<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="MP Resume Builder — create, edit, preview and download professional resumes.">
<title>MP Resume Builder</title>
<link rel="stylesheet" href="style.css">
</head>

<body>

<nav class="nav">
  <div class="navin">
    <div class="brand">
      <img class="logo-img" src="logo.jpg" alt="MP Resume Builder Logo">
    </div>

    <div class="navlinks">
      <a href="#builder">Builder</a>
      <a href="#features">Features</a>
      <a href="#contact">Contact</a>
      <a href="https://www.instagram.com/mpdigitalhub/" target="_blank" rel="noopener">Instagram ↗</a>
    </div>
  </div>
</nav>

<header class="hero">
  <span class="pill">✦ AI-ASSISTED RESUME BUILDER</span>

  <h1>
    Build a resume that looks
    <span class="grad">career-ready.</span>
  </h1>

  <p>
    Create, edit, preview and download a professional resume directly
    from your browser. Perfect for students, freshers and professionals.
  </p>

  <div class="actions">
    <a class="btn primary" href="#builder">Create My Resume →</a>

    <a
      class="btn secondary"
      href="https://www.instagram.com/mpdigitalhub/"
      target="_blank"
      rel="noopener"
    >
      Follow us on Instagram
    </a>
  </div>
</header>


<main class="app" id="builder">

<div class="layout">

<section class="card form">

  <h2 style="margin:0 0 4px;font-size:21px;">
    Resume Builder
  </h2>

  <div class="notice">
    Fill the sections below. Your resume updates instantly and automatically
    stays saved in this browser.
  </div>


  <div class="tabs">
    <button class="tab active" data-tab="personal">
      Personal
    </button>

    <button class="tab" data-tab="experience">
      Experience
    </button>

    <button class="tab" data-tab="education">
      Education
    </button>

    <button class="tab" data-tab="skills">
      Skills
    </button>
  </div>


  <!-- PERSONAL -->

  <div class="section active" id="personal">

    <div class="field">
      <label>FULL NAME</label>
      <input id="name" placeholder="Your full name">
    </div>

    <div class="field">
      <label>PROFESSIONAL TITLE</label>
      <input id="role" placeholder="e.g. Web Developer">
    </div>

    <div class="two">

      <div class="field">
        <label>PHONE</label>
        <input id="phone" placeholder="+91...">
      </div>

      <div class="field">
        <label>EMAIL</label>
        <input id="email" placeholder="you@email.com">
      </div>

    </div>


    <div class="two">

      <div class="field">
        <label>LOCATION</label>
        <input id="location" placeholder="City, India">
      </div>

      <div class="field">
        <label>LINK / WEBSITE</label>
        <input id="website" placeholder="linkedin.com/in/...">
      </div>

    </div>


    <div class="field">
      <label>PROFESSIONAL SUMMARY</label>

      <textarea
        id="summary"
        placeholder="Write a short professional summary"
      ></textarea>
    </div>


    <div class="field">
      <label>PROFILE PHOTO — OPTIONAL</label>
      <input id="photo" type="file" accept="image/*">
    </div>


    <button class="btn primary" id="ai">
      ✦ Improve Summary with AI
    </button>

  </div>


  <!-- EXPERIENCE -->

  <div class="section" id="experience">

    <div
      style="
        display:flex;
        justify-content:space-between;
        align-items:center;
      "
    >
      <b>Work Experience</b>

      <button class="add" id="addExp">
        + Add
      </button>
    </div>

    <div id="expList"></div>

  </div>


  <!-- EDUCATION -->

  <div class="section" id="education">

    <div
      style="
        display:flex;
        justify-content:space-between;
        align-items:center;
      "
    >

      <b>Education</b>

      <button class="add" id="addEdu">
        + Add
      </button>

    </div>

    <div id="eduList"></div>

  </div>


  <!-- SKILLS -->

  <div class="section" id="skills">

    <div class="field">

      <label>
        SKILLS — COMMA SEPARATED
      </label>

      <textarea
        id="skillsInput"
        placeholder="HTML, CSS, JavaScript, Communication"
      ></textarea>

    </div>


    <div class="field">

      <label>
        LANGUAGES — COMMA SEPARATED
      </label>

      <input
        id="languages"
        placeholder="English, Hindi, Punjabi"
      >

    </div>


    <div class="field">

      <label>
        CERTIFICATIONS / ACHIEVEMENTS — ONE PER LINE
      </label>

      <textarea id="achievements"></textarea>

    </div>


    <button class="btn primary" id="download2">
      ⬇ Download Resume PDF
    </button>

    <button class="btn secondary" id="reset">
      Reset
    </button>

  </div>

</section>


<!-- PREVIEW -->

<section class="card preview">

  <div class="toolbar">

    <div>

      <div class="toolbar-title">
        Live Preview
      </div>

      <div class="toolbar-sub">
        A4-ready professional resume layout
      </div>

    </div>


    <div>

      <button class="btn secondary" id="copy">
        Copy Text
      </button>

      <button class="btn primary" id="download">
        ⬇ Download PDF
      </button>

    </div>

  </div>


  <article class="resume" id="resume">

    <div class="rhead">

      <div>

        <div class="name" id="rName">
          Your Name
        </div>

        <div class="role" id="rRole">
          Professional Title
        </div>

      </div>


      <div>

        <img
          id="rPhoto"
          class="photo"
          style="display:none"
          alt="Profile photo"
        >

      </div>


      <div class="contact" id="rContact">

        Phone · Email · City
        <br>
        LinkedIn / Website

      </div>

    </div>


    <div class="rsec">

      <h3>Profile</h3>

      <p id="rSummary">
        Your professional summary will appear here.
      </p>

    </div>


    <div
      class="rsec"
      id="expSec"
      style="display:none"
    >

      <h3>Experience</h3>

      <div id="rExp"></div>

    </div>


    <div
      class="rsec"
      id="eduSec"
      style="display:none"
    >

      <h3>Education</h3>

      <div id="rEdu"></div>

    </div>


    <div
      class="rsec"
      id="skillSec"
      style="display:none"
    >

      <h3>Skills</h3>

      <div
        class="skills"
        id="rSkills"
      ></div>

    </div>


    <div
      class="rsec"
      id="langSec"
      style="display:none"
    >

      <h3>Languages</h3>

      <div
        class="langs"
        id="rLanguages"
      ></div>

    </div>


    <div
      class="rsec"
      id="achSec"
      style="display:none"
    >

      <h3>
        Certifications & Achievements
      </h3>

      <div
        class="achievements"
        id="rAchievements"
      ></div>

    </div>

  </article>

</section>

</div>

</main>


<!-- FEATURES -->

<section class="features" id="features">

<div class="feature-card">

  <span class="pill">
    MP RESUME BUILDER
  </span>

  <h2 style="margin-top:12px;">
    Everything you need to create a polished resume.
  </h2>

  <p
    style="
      color:#697084;
      margin-top:7px;
      font-size:14px;
    "
  >
    Simple, fast and professional resume creation directly
    from your browser.
  </p>


  <div class="feature-grid">

    <div class="feature">

      <b>⚡ Live Preview</b>

      <p>
        See your resume update instantly.
      </p>

    </div>


    <div class="feature">

      <b>✦ AI Summary</b>

      <p>
        Improve your professional summary.
      </p>

    </div>


    <div class="feature">

      <b>💾 Auto Save</b>

      <p>
        Your data stays saved in your browser.
      </p>

    </div>


    <div class="feature">

      <b>📄 PDF Ready</b>

      <p>
        Print or save your resume as PDF.
      </p>

    </div>


    <div class="feature">

      <b>📱 Mobile Friendly</b>

      <p>
        Works smoothly on phones and desktops.
      </p>

    </div>


    <div class="feature">

      <b>💬 WhatsApp Support</b>

      <p>
        Contact MP Resume Builder instantly.
      </p>

    </div>

  </div>

</div>

</section>


<!-- CONTACT -->

<section class="contact-bar" id="contact">

<div class="contact-card">

  <div>

    <div class="contact-title">
      MP RESUME BUILDER
    </div>

    <div class="contact-info">

      📍 Madhya Pradesh, India
      <br>

      ✉ @supportmpdigitalhub
      <br>

      ☎ +91 9131053539

    </div>

  </div>


  <div class="contact-actions">

    <a
      class="social-btn whatsapp-btn"
      href="https://wa.me/919131053539?text=Hi%20MP%20Resume%20Builder%2C%20I%20need%20help%20with%20the%20resume%20builder."
      target="_blank"
      rel="noopener"
      aria-label="Chat with MP Resume Builder on WhatsApp"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.1 1.6 5.8L.1 24l6.5-1.7a11.9 11.9 0 0 0 5.5 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.3-6.2-3.5-8.4ZM12.2 21.6c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.9 1 1-3.8-.2-.4a9.7 9.7 0 0 1-1.5-5.2C2.2 6.2 6.7 1.9 12.1 1.9c2.6 0 5.1 1 6.9 2.8a9.7 9.7 0 0 1 2.9 6.9c0 5.5-4.3 10-9.7 10Zm5.3-7.4c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.7.9-.8 1.1-.2.2-.3.2-.6.1-1.7-.8-2.8-1.5-3.9-3.4-.3-.5.3-.5.8-1.7.1-.2.1-.4 0-.6l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.2 2.2 3.4 5.3 4.7 2 .9 2.8 1 3.8.8.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.1-1.4-.1-.1-.3-.2-.6-.3Z"/>

      </svg>

      <span>WhatsApp</span>

    </a>


    <a
      class="social-btn instagram-btn"
      href="https://www.instagram.com/mpdigitalhub/"
      target="_blank"
      rel="noopener"
      aria-label="Follow MP Digital Hub on Instagram"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <rect
          x="3"
          y="3"
          width="18"
          height="18"
          rx="5"
        ></rect>

        <circle
          cx="12"
          cy="12"
          r="4"
        ></circle>

        <circle
          cx="17.4"
          cy="6.6"
          r="1"
        ></circle>

      </svg>

      <span>Instagram</span>

    </a>

  </div>

</div>

</section>


<footer>

© 2026

<a
  href="https://www.instagram.com/mpdigitalhub/"
  target="_blank"
  rel="noopener"
>
  MP Digital Hub
</a>

· MP Resume Builder

</footer>


<!-- FLOATING BUTTONS -->

<div class="floating">

  <a
    class="float-btn wa"
    href="https://wa.me/919131053539?text=Hi%20MP%20Resume%20Builder%2C%20I%20need%20help%20with%20the%20resume%20builder."
    target="_blank"
    rel="noopener"
    aria-label="WhatsApp"
  >

    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
    >

      <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.1 1.6 5.8L.1 24l6.5-1.7a11.9 11.9 0 0 0 5.5 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.3-6.2-3.5-8.4ZM12.2 21.6c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.9 1 1-3.8-.2-.4a9.7 9.7 0 0 1-1.5-5.2C2.2 6.2 6.7 1.9 12.1 1.9c2.6 0 5.1 1 6.9 2.8a9.7 9.7 0 0 1 2.9 6.9c0 5.5-4.3 10-9.7 10Zm5.3-7.4c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.7.9-.8 1.1-.2.2-.3.2-.6.1-1.7-.8-2.8-1.5-3.9-3.4-.3-.5.3-.5.8-1.7.1-.2.1-.4 0-.6l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.2 2.2 3.4 5.3 4.7 2 .9 2.8 1 3.8.8.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.1-1.4-.1-.1-.3-.2-.6-.3Z"/>

    </svg>

    <span>WhatsApp</span>

  </a>


  <a
    class="float-btn ig float-instagram"
    href="https://www.instagram.com/mpdigitalhub/"
    target="_blank"
    rel="noopener"
    aria-label="Instagram"
  >

    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
    >

      <rect
        x="3"
        y="3"
        width="18"
        height="18"
        rx="5"
      ></rect>

      <circle
        cx="12"
        cy="12"
        r="4"
      ></circle>

      <circle
        cx="17.4"
        cy="6.6"
        r="1"
      ></circle>

    </svg>

    <span>Instagram</span>

  </a>

</div>


<div class="toast" id="toast">
  Saved
</div>


<script src="script.js"></script>

</body>
</html>
